{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@opencode/plugin": [
        "./node_modules/@opencode/plugin/dist/promise/index.d.ts"
      ],
      "@opencode/client": [
        "./node_modules/@opencode/client/dist/promise/index.d.ts"
      ],
      "zod": [
        "./node_modules/zod/index.d.ts"
      ],
      "yaml": [
        "./node_modules/yaml/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "tests-entry.ts"
  ]
}
